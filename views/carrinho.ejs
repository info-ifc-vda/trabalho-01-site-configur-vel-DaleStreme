<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Meu Carrinho - KickOFF</title>
  <link rel="icon" href="/icone/favicon.ico" type="image/x-icon">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet" />

  <!-- CSS Externo -->
  <link rel="stylesheet" href="/css/carrinho.css" />
</head>
<body>

  <%- include('partials/topbar') %>

  <!-- 2. Navbar Principal -->
  <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom py-2 px-4">
    <div class="container-fluid">
       <a class="navbar-brand py-0 d-flex align-items-center gap-2 text-decoration-none text-dark" href="/">
  <img src="/icone/Logo2.webp" alt="KICKOFF" style="height: 35px; width: auto; object-fit: contain;">
</a>

      <div class="collapse navbar-collapse justify-content-center show" id="navbarNav">
        <ul class="navbar-nav gap-3 fw-bold">
          <li class="nav-item"><a class="nav-link" href="/">Destaques</a></li>
          <% categorias.forEach(categoria => { %>
            <li class="nav-item">
              <a class="nav-link" href="/categoria/<%= categoria.nome %>"><%= categoria.nome %></a>
            </li>
          <% }) %>
        </ul>
      </div>

      <div class="d-flex align-items-center gap-3">
        <%- include('partials/conta') %>
        <a href="/carrinho" class="text-dark fs-5 position-relative">
          <i class="bi bi-cart3"></i>
        </a>
      </div>
    </div>
  </nav>

  <!-- 3. Conteúdo Principal -->
  <div class="container my-4 px-4">
    
    <!-- Topo: Breadcrumb + Stepper -->
    <div class="d-flex justify-content-between align-items-center mb-3">
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb m-0">
          <li class="breadcrumb-item"><a href="/">Início</a></li>
          <li class="breadcrumb-item active" aria-current="page">Carrinho</li>
        </ol>
      </nav>

      <!-- Stepper de Passos -->
      <div class="stepper d-flex align-items-center gap-2">
        <div class="step-active d-flex align-items-center gap-1">
          <span class="step-number">1</span>
          <span>Carrinho</span>
        </div>
        <span class="step-line"></span>
        <div class="step-inactive d-flex align-items-center gap-1">
          <span class="step-number">2</span>
          <span>Finalizar compra</span>
        </div>
        <span class="step-line"></span>
        <div class="step-inactive d-flex align-items-center gap-1">
          <span class="step-number">3</span>
          <span>Confirmação</span>
        </div>
      </div>
    </div>

    <!-- Título -->
    <div class="d-flex align-items-baseline gap-2 mb-4">
      <h2 class="fw-bold m-0 titulo-carrinho">Meu carrinho</h2>
      <span class="text-muted small"><%= totalQtd %> produto(s)</span>
    </div>

    <% if (itensCarrinho.length === 0) { %>
      <div class="text-center py-5 border rounded-3 bg-light my-4">
        <i class="bi bi-cart-x display-1 text-muted"></i>
        <h4 class="fw-bold mt-3">Seu carrinho está vazio</h4>
        <p class="text-muted small mb-4">Nenhum produto foi adicionado ainda. Confira os destaques da nossa loja!</p>
        <a href="/" class="btn btn-black rounded-pill px-4">Explorar catálogo</a>
      </div>
    <% } else { %>
      <div class="row g-5">
        
        <!-- Coluna Esquerda: Lista de Produtos e Frete -->
        <div class="col-lg-7">
          
          <% itensCarrinho.forEach((item, index) => { %>
            <div class="d-flex justify-content-between pb-4 mb-4 border-bottom">
              <div class="d-flex gap-3">
                <div class="product-img-bg">
                  <img src="/uploads/<%= item.imagem %>" alt="<%= item.nome %>" class="img-fluid" />
                </div>
                <div>
                  <h6 class="fw-bold mb-1"><%= item.nome %></h6>
                  <p class="text-muted small mb-1"><%= item.categoria %></p>
                  <p class="text-muted small mb-3">Tamanho: <%= item.tamanho %></p>
                  
                  <!-- Seletor de Quantidade -->
                  <div class="btn-qty d-inline-flex align-items-center gap-2">
                    <form action="/carrinho/atualizar" method="POST" class="d-inline">
                      <input type="hidden" name="index" value="<%= index %>">
                      <input type="hidden" name="acao" value="diminuir">
                      <button type="submit">&minus;</button>
                    </form>

                    <span><%= item.qtd %></span>

                    <form action="/carrinho/atualizar" method="POST" class="d-inline">
                      <input type="hidden" name="index" value="<%= index %>">
                      <input type="hidden" name="acao" value="aumentar">
                      <button type="submit">&plus;</button>
                    </form>
                  </div>
                </div>
              </div>
              <div class="text-end d-flex flex-column justify-content-between">
                <span class="fw-bold fs-6">R$ <%= (Number(item.valor) * item.qtd).toFixed(2).replace('.', ',') %></span>
                <form action="/carrinho/remover" method="POST">
                  <input type="hidden" name="index" value="<%= index %>">
                  <button type="submit" class="btn btn-link p-0 text-muted small text-decoration-underline texto-mini">
                    <i class="bi bi-trash me-1"></i>Remover
                  </button>
                </form>
              </div>
            </div>
          <% }) %>

          <!-- Seção: Calcule o frete -->
          <div class="mt-4">
            <h5 class="fw-bold mb-3">Calcule o frete e o prazo</h5>
            <label class="form-label small fw-bold text-muted mb-1 texto-mini">CEP</label>
            
            <form action="/carrinho/frete" method="POST" class="d-flex gap-2 mb-2 form-frete">
              <input type="text" name="cep" class="form-control rounded-3 py-2 campo-frete" placeholder="00000-000" value="<%= typeof cep !== 'undefined' ? cep : '' %>" required />
              <button type="submit" class="btn btn-outline-dark rounded-pill px-4 btn-calcular">Calcular</button>
            </form>
            
            <a href="https://buscacepinter.correios.com.br/app/endereco/index.php" target="_blank" class="text-muted small text-decoration-underline d-block mb-3 texto-mini">Não sei meu CEP</a>
            
            <% if (typeof cep !== 'undefined' && cep) { %>
              <span class="text-muted small d-block mb-2 texto-mini">Entrega para o CEP <%= cep %></span>

              <!-- Opção de Frete Selecionada -->
              <div class="frete-card d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-2">
                  <span class="badge-green"></span>
                  <div>
                    <strong class="d-block small texto-13">Entrega padrão</strong>
                    <span class="text-muted texto-mini">Em até 5 dias úteis após a confirmação do pagamento</span>
                  </div>
                </div>
                <strong class="texto-13">R$ <%= valorFrete.toFixed(2).replace('.', ',') %></strong>
              </div>
            <% } %>
          </div>

        </div>

        <!-- Coluna Direita: Resumo do Pedido + Cupom -->
        <div class="col-lg-5">
          
          <!-- Resumo do Pedido -->
          <div class="summary-card mb-4">
            <h5 class="fw-bold mb-1">Resumo do pedido</h5>
            <span class="text-muted small d-block mb-4 texto-12"><%= totalQtd %> produto(s) na sua sacola</span>

            <div class="d-flex justify-content-between mb-2 small">
              <span class="text-muted">Subtotal</span>
              <span class="fw-semibold">R$ <%= subtotal.toFixed(2).replace('.', ',') %></span>
            </div>

            <% if (descontoCupom > 0) { %>
              <div class="d-flex justify-content-between mb-2 small">
                <span class="text-muted">Cupom <%= cupom.codigo %></span>
                <span class="text-success fw-semibold"> R$ <%= descontoCupom.toFixed(2).replace('.', ',') %></span>
              </div>
            <% } %>

            <div class="d-flex justify-content-between mb-4 small">
              <span class="text-muted">Entrega padrão</span>
              <span class="fw-semibold">R$ <%= valorFrete.toFixed(2).replace('.', ',') %></span>
            </div>

            <div class="d-flex justify-content-between align-items-baseline pt-3 border-top mb-1">
              <span class="fw-bold fs-5">Total</span>
              <span class="fw-bold fs-4 total-valor">R$ <%= totalGeral.toFixed(2).replace('.', ',') %></span>
            </div>
            <span class="text-muted small d-block text-end mb-4 texto-mini">À vista no Pix</span>

            <div class="d-grid gap-2">
              <a href="/pedido" class="btn btn-black w-100 text-center text-decoration-none">Finalizar compra</a>
              <a href="/" class="btn btn-outline-custom w-100 text-center text-decoration-none">Continuar comprando</a>
            </div>

            <div class="text-center mt-3 text-muted small d-flex align-items-center justify-content-center gap-1 texto-mini">
              <i class="bi bi-lock"></i>
              <span>Compra segura. Seus dados protegidos.</span>
            </div>
          </div>

          <div class="coupon-box">
            <label class="fw-bold d-block mb-2 texto-13">Cupom de desconto</label>
            
            <% if (typeof cupom !== 'undefined' && cupom) { %>
              <div class="d-flex justify-content-between align-items-center mb-1">
                <div class="d-flex align-items-center gap-2">
                  <i class="bi bi-ticket-perforated"></i>
                  <strong class="texto-13"><%= cupom.codigo %></strong>
                </div>
                <form action="/carrinho/remover-cupom" method="POST">
                  <button type="submit" class="btn btn-link p-0 text-muted small text-decoration-underline texto-mini">Remover</button>
                </form>
              </div>
              <span class="text-success small texto-mini">Cupom aplicado: R$ <%= cupom.valor.toFixed(2).replace('.', ',') %> de desconto.</span>
            <% } else { %>
              <form action="/carrinho/cupom" method="POST" class="d-flex gap-2">
                <input type="text" name="codigo" class="form-control form-control-sm rounded-pill" placeholder="Digite seu cupom (Ex: JOGO50)" required />
                <button type="submit" class="btn btn-dark btn-sm rounded-pill px-3">Aplicar</button>
              </form>
            <% } %>
          </div>

        </div>

      </div>
    <% } %>
  </div>

  <!-- 4. Rodapé -->
  <%- include('partials/rodape') %>

  <!-- Bootstrap 5 JS Bundle -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>