<%- include('partials/header') %>

<main class="container d-flex align-items-center min-vh-100 my-4">
  <div class="row g-5 align-items-center w-100 mx-auto">
    
    <!-- Coluna Esquerda (Promo/Banner) -->
    <div class="col-lg-6">
      <div
        class="promo-box p-4 p-md-5 d-flex flex-column justify-content-between"
        style="background-color: #111111; border-radius: 8px; min-height: 520px"
      >
        <div>
          <div class="d-flex align-items-center mb-3">
            <i class="bi bi-shield-check text-white me-2"></i>
            <span
              class="text-uppercase fw-bold text-white"
              style="font-size: 11px; letter-spacing: 1px"
              >Área Administrativa</span
            >
          </div>
          <h1
            class="display-4 fw-bold mt-2 mb-3 text-white"
            style="letter-spacing: -2px; line-height: 1.1"
          >
            Por trás de cada jogada.
          </h1>
          <p
            class="text-white-50 mb-3"
            style="max-width: 400px; font-size: 15px"
          >
            Pedidos, produtos e clientes. Tudo o que sua equipe precisa para
            manter a KICKOFF em campo.
          </p>
        </div>

        <div class="pt-3 border-top border-secondary">
          <h6 class="fw-bold text-white mb-2" style="font-size: 15px">
            Acesso exclusivo da equipe.
          </h6>
          <p
            class="text-white-50 small mb-3"
            style="max-width: 380px; font-size: 13px"
          >
            Utilize suas credenciais administrativas. Contas de clientes não têm
            acesso a este painel.
          </p>
          <div
            class="text-uppercase fw-bold text-white-50"
            style="font-size: 11px; letter-spacing: 1px"
          >
            KICKOFF / Gestão da Loja
          </div>
        </div>
      </div>
    </div>

    <!-- Coluna Direita (Formulário de Login) -->
    <div class="col-lg-6 px-lg-5">
      
      <!-- Cabeçalho do Formulário com o Botão de Voltar à Loja -->
      <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
          <span
            class="text-uppercase fw-bold text-secondary"
            style="font-size: 11px; letter-spacing: 1px"
            >Acesso Restrito</span
          >
          <h2 class="fw-bold mt-1" style="letter-spacing: -1px">
            Entrar no Admin.
          </h2>
        </div>
        <!-- Opção de Voltar à Tela Inicial -->
        <a href="/" class="text-dark small fw-semibold text-decoration-none border px-3 py-2 rounded-pill bg-light shadow-sm">
          <i class="bi bi-arrow-left me-1"></i> Início
        </a>
      </div>

      <p class="text-secondary small mb-4">
        Acesse o painel para gerenciar a operação da loja.
      </p>

      <form action="/admin/login" method="POST">
        <div class="row">
          <div class="col-md-12">
            
            <div class="mb-3">
              <label for="email" class="form-label text-uppercase fw-bold text-secondary" style="font-size: 12px; letter-spacing: 0.5px">E-mail</label>
              <input type="email" class="form-control py-2" id="email" name="email" placeholder="Seu e-mail cadastrado" required style="font-size: 14px; border-radius: 6px" />
            </div>

            <div class="mb-2">
              <label for="senha" class="form-label text-uppercase fw-bold text-secondary" style="font-size: 12px; letter-spacing: 0.5px">Senha</label>
              <div class="input-group">
                <input type="password" class="form-control py-2" id="senha" name="senha" placeholder="Digite sua senha" required style="font-size: 14px; border-radius: 6px 0 0 6px" />
                <span class="input-group-text bg-white border-start-0 text-secondary" id="toggleSenha" style="cursor: pointer; border-radius: 0 6px 6px 0">
                  <i class="bi bi-eye-slash"></i>
                </span>
              </div>
            </div>

            <div class="text-end mb-3">
              <a href="#" class="text-secondary small text-decoration-underline">Esqueci minha senha</a>
            </div>

            <button
              type="submit"
              class="btn btn-dark w-100 py-2 mb-3 fw-semibold text-white"
              style="border-radius: 30px; background-color: #111; border: none;"
            >
              Entrar
            </button>

            <div class="text-center mt-2">
              <span class="text-secondary small">
                É cliente?
                <a href="/login" class="text-dark fw-semibold text-decoration-underline">Acesse sua conta</a>
              </span>
            </div>

          </div>
        </div>
      </form>
    </div>
  </div>
</main>

<%- include('partials/footer') %>