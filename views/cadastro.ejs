<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>KickOFF - Crie sua conta</title>
    <link rel="icon" href="/icone/favicon.ico" type="image/x-icon">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    
    <!-- CSS Externo -->
    <link rel="stylesheet" href="/css/cadastro.css">
</head>
<body>

    <!-- Navbar Principal Funcional -->
    <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom py-3 px-4">
        <div class="container-fluid">
           <a class="navbar-brand py-0 d-flex align-items-center gap-2 text-decoration-none text-dark" href="/">
  <img src="/icone/Logo2.webp" alt="KICKOFF" style="height: 35px; width: auto; object-fit: contain;">
</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse justify-content-center" id="navbarNav">
                <ul class="navbar-nav gap-3">
                    <li class="nav-item"><a class="nav-link" href="/">Destaques</a></li>
                    <% categorias.forEach(function(categoria) { %>
                        <li class="nav-item">
                            <a class="nav-link" href="/categoria/<%= categoria.nome %>"><%= categoria.nome %></a>
                        </li>
                    <% }) %>
                </ul>
            </div>
            <a href="/" class="text-dark text-decoration-none fw-semibold small"><i class="bi bi-arrow-left me-1"></i> Voltar à loja</a>
        </div>
    </nav>

    <!-- Conteúdo Principal -->
    <div class="container my-5">
        <div class="row g-5 align-items-center">
            
            <!-- Coluna Esquerda (Banner / Promo) -->
            <div class="col-lg-6">
                <div class="promo-box p-5 d-flex flex-column justify-content-between" style="min-height: 600px;">
                    <div>
                        <span class="text-uppercase fw-bold text-white" style="font-size: 11px; letter-spacing: 1px;">Dentro e fora de campo.</span>
                        <h1 class="display-4 fw-bold mt-2 mb-4 text-white" style="letter-spacing: -2px; line-height: 1.1;">Entre para o nosso time.</h1>
                        <p class="text-secondary mb-4" style="max-width: 400px; font-size: 15px;">
                            A chuteira certa para o seu pontapé inicial. Faça parte da KickOFF e encontre o modelo para o seu estilo de jogo.
                        </p>
                    </div>

                    <div class="my-4">
                        <div class="d-flex align-items-center mb-3">
                            <i class="bi bi-box fs-4 me-3 text-white"></i>
                            <div>
                                <h6 class="mb-0 fw-bold text-white" style="font-size: 14px;">Seus pedidos, de perto</h6>
                                <small class="text-secondary">Acompanhe cada etapa da sua compra.</small>
                            </div>
                        </div>
                        <div class="d-flex align-items-center">
                            <i class="bi bi-shield-check text-white fs-4 me-3"></i>
                            <div>
                                <h6 class="mb-0 fw-bold text-white" style="font-size: 14px;">Seu jogo, seu estilo</h6>
                                <small class="text-secondary">Futsal, futebol e society em um só lugar.</small>
                            </div>
                        </div>
                    </div>
                    
                    <div class="d-flex justify-content-between text-uppercase fw-bold pt-3 border-top border-secondary" style="font-size: 11px;">
                        <span class="text-secondary">Futsal</span>
                        <span class="text-secondary">Futebol</span>
                        <span class="text-secondary">Society</span>
                    </div>
                </div>
            </div>

            <!-- Coluna Direita (Formulário de Cadastro) -->
            <div class="col-lg-6 px-lg-5">
                <div class="mb-4">
                    <span class="text-uppercase fw-bold text-secondary" style="font-size: 11px; letter-spacing: 1px;">Minha Conta</span>
                    <h2 class="fw-bold mt-1" style="letter-spacing: -1px;">Crie sua conta.</h2>
                    <p class="text-secondary small">É rápido, gratuito e deixa você mais perto do jogo. Todos os campos são obrigatórios.</p>
                </div>

                <% if (erro) { %>
                    <div class="alert alert-danger py-2 small"><%= erro %></div>
                <% } %>

                <div id="mensagemErro" class="alert alert-danger py-2 small d-none"></div>

                <form action="/cadastro-salvo" method="POST" onsubmit="return validarCadastro()">
                    <div class="mb-3">
                        <label for="nome" class="form-label">Nome completo</label>
                        <input type="text" class="form-control" id="nome" name="nome" placeholder="Como você se chama?" value="<%= nome %>" required>
                    </div>
                    <div class="mb-3">
                        <label for="email" class="form-label">Email</label>
                        <input type="email" class="form-control" id="email" name="email" placeholder="exemplo@ex.com" value="<%= email %>" required>
                    </div>
                    <div class="mb-3">
                        <label for="senha1" class="form-label">Senha</label>
                        <input type="password" class="form-control" id="senha1" name="senha" placeholder="Crie uma senha" minlength="8" required>
                        <div class="form-text">Use pelo menos 8 caracteres.</div>
                    </div>
                    <div class="mb-2">
                        <label for="senha2" class="form-label">Confirmar senha</label>
                        <input type="password" class="form-control" id="senha2" name="confirmar" placeholder="Repita a senha" minlength="8" required>
                    </div>

                    <div class="mb-3 form-check mt-3">
                        <input type="checkbox" class="form-check-input" id="termos" required>
                        <label class="form-check-label text-muted small" for="termos">
                            Li e aceito os <a href="#" class="text-dark">Termos de uso</a> e a <a href="#" class="text-dark">Política de Privacidade</a> da KickOFF.
                        </label>
                    </div>

                    <button type="submit" class="btn btn-dark-custom w-100 mb-3">Criar minha conta</button>

                    <div class="text-center mt-3">
                        <span class="text-secondary small">Já tem uma conta? <a href="/login" class="text-dark fw-semibold text-decoration-underline">Entrar</a></span>
                    </div>
                </form>
            </div>

        </div>
    </div>

    <!-- Rodapé -->
    <footer class="border-top py-4 px-4 mt-5">
        <div class="container-fluid d-flex flex-column flex-md-row justify-content-between align-items-center">
            <span class="footer-text mb-2 mb-md-0">&copy; 2026 KickOFF. Todos os direitos reservados.</span>
            <div>
                <a href="#" class="footer-text text-decoration-none text-secondary me-3">Privacidade</a>
                <a href="#" class="footer-text text-decoration-none text-secondary me-3">Termos de uso</a>
            </div>
        </div>
    </footer>

    <script>
        function validarCadastro() {
            const senha = document.getElementById('senha1').value;
            const confirmar = document.getElementById('senha2').value;
            const mensagem = document.getElementById('mensagemErro');

            if (senha !== confirmar) {
                mensagem.innerText = 'As senhas não coincidem.';
                mensagem.classList.remove('d-none');
                return false;
            }

            return true;
        }
    </script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>