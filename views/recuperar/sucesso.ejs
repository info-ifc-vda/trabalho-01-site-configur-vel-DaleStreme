<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>KICKOFF - Senha alterada</title>
  <link rel="icon" href="/icone/favicon.ico" type="image/x-icon">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
  <link rel="stylesheet" href="/css/recuperar.css">
</head>
<body>

  <%- include('../partials/navbar-recuperar') %>

  <div class="container-fluid px-4 my-4">
    <div class="row g-4">

      <div class="col-lg-5">
        <%- include('../partials/painel-recuperar', {
          titulo: 'Tudo pronto.<br>Bora pro<br>jogo!',
          texto: 'Sua conta está protegida e pronta para você continuar de onde parou.'
        }) %>
      </div>

      <div class="col-lg-7 d-flex align-items-center justify-content-center">
        <div class="formulario-recuperar">
          <div class="icone-sucesso mb-3"><i class="bi bi-check-lg"></i></div>
          <div class="etiqueta-pequena mb-2">Senha atualizada</div>
          <h3 class="fw-bold">Senha alterada!</h3>
          <p class="text-muted small">Pronto! Sua senha foi atualizada. Use a nova senha no seu próximo acesso.</p>

          <a href="/login" class="btn btn-preto w-100 fw-bold">Entrar na minha conta</a>

          <div class="text-center mt-3">
            <a href="/" class="text-dark text-decoration-none small">
              <i class="bi bi-arrow-left me-1"></i> Voltar à loja
            </a>
          </div>

          <p class="text-center text-muted small mt-3 mb-0">
            <i class="bi bi-lock me-1"></i> Seus dados protegidos, seu jogo em foco.
          </p>
        </div>
      </div>

    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>