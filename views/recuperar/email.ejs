<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>KICKOFF - Recuperar conta</title>
  <link rel="icon" href="/icone/favicon.ico" type="image/x-icon">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
  <link rel="stylesheet" href="/css/recuperar.css">
</head>
<body>

  <%- include('../partials/navbar-recuperar') %>

  <div class="container-fluid px-4 my-4">
    <div class="row g-4">

      <div class="col-lg-5">
        <%- include('../partials/painel-recuperar', {
          titulo: 'Todo craque<br>se recupera.',
          texto: 'Informe seu e-mail e a gente te ajuda a voltar ao jogo em poucos minutos.'
        }) %>
      </div>

      <div class="col-lg-7 d-flex align-items-center justify-content-center">
        <div class="formulario-recuperar">
          <div class="etiqueta-pequena mb-2">Recuperar conta</div>
          <h3 class="fw-bold">Recupere sua conta</h3>
          <p class="text-muted small">Informe o e-mail cadastrado na KickOFF e enviaremos um código de 6 dígitos para você criar uma nova senha.</p>

          <% if (erro) { %>
            <div class="alert alert-danger py-2 small"><%= erro %></div>
          <% } %>

          <form action="/recuperar/enviar-codigo" method="POST">
            <label for="email" class="form-label small fw-bold">E-mail cadastrado</label>
            <input type="email" class="form-control mb-3" id="email" name="email" placeholder="seuemail@email.com" required>

            <button type="submit" class="btn btn-preto w-100 fw-bold">Enviar código</button>
          </form>

          <div class="text-center mt-3">
            <a href="/login" class="text-dark text-decoration-none small">
              <i class="bi bi-arrow-left me-1"></i> Voltar para o login
            </a>
          </div>

          <p class="text-center text-muted small mt-3 mb-0">
            <i class="bi bi-lock me-1"></i> Seus dados protegidos, seu jogo em foco.
          </p>
        </div>
      </div>

    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>