<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>KICKOFF - Destaques</title>
  <link rel="icon" href="/icone/favicon.ico" type="image/x-icon">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

  <!-- CSS Externo Separado -->
  <link rel="stylesheet" href="/css/index.css">
</head>
<body>

  <%- include('partials/topbar') %>

  <%
    const base = '/';

    let textoOrdem = 'Relevância';
    if (ordem == 'menor') { textoOrdem = 'Menor preço'; }
    if (ordem == 'maior') { textoOrdem = 'Maior preço'; }
  %>

  <!-- NAVBAR -->
  <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom py-2">
    <div class="container">
     <a class="navbar-brand py-0 d-flex align-items-center gap-2 text-decoration-none text-dark" href="/">
  <img src="/icone/Logo2.webp" alt="KICKOFF" style="height: 35px; width: auto; object-fit: contain;">
</a>

      <div class="collapse navbar-collapse justify-content-center show">
        <ul class="navbar-nav gap-3 fw-bold">
          <li class="nav-item"><a class="nav-link active" href="/">Destaques</a></li>
          <% categorias.forEach(categoria => { %>
            <li class="nav-item">
              <a class="nav-link" href="/categoria/<%= categoria.nome %>"><%= categoria.nome %></a>
            </li>
          <% }) %>
        </ul>
      </div>

      <div class="d-flex align-items-center gap-3">
        <div class="busca">
          <i class="bi bi-search"></i>
          <input type="text" placeholder="Buscar">
        </div>
        <a href="/carrinho" class="text-dark fs-5"><i class="bi bi-cart3"></i></a>
        <%- include('partials/conta') %>
      </div>

    </div>
  </nav>

  <div class="container my-4">

    <!-- ATALHOS RÁPIDOS -->
    <div class="shortcuts-container p-3 mb-4">
      <h6 class="fw-bold mb-3">Atalhos rápidos</h6>
      <div class="row g-3">
        <div class="col-md-4">
          <a href="/login" class="shortcut-card">
            <div class="shortcut-icon"><i class="bi bi-person"></i></div>
            <div>
              <div class="fw-bold">Login do cliente</div>
              <small class="text-muted">Acesse sua conta</small>
            </div>
          </a>
        </div>
        <div class="col-md-4">
          <a href="/cadastro" class="shortcut-card">
            <div class="shortcut-icon"><i class="bi bi-person-add"></i></div>
            <div>
              <div class="fw-bold">Cadastro</div>
              <small class="text-muted">Crie sua conta</small>
            </div>
          </a>
        </div>
        <div class="col-md-4">
          <a href="/admin" class="shortcut-card">
            <div class="shortcut-icon"><i class="bi bi-shield-check"></i></div>
            <div>
              <div class="fw-bold">Acesso Admin</div>
              <small class="text-muted">Painel administrativo</small>
            </div>
          </a>
        </div>
      </div>
    </div>

    <!-- TÍTULO + CONTADOR + OCULTAR FILTROS + ORDENAR -->
    <div class="d-flex justify-content-between align-items-center mb-4">
      <small class="text-muted"><%= produtos.length %> <%= produtos.length == 1 ? 'produto' : 'produtos' %></small>

      <div class="d-flex align-items-center gap-4">
        <% if (ocultar == '1') { %>
          <a href="<%= base %>?categoria=<%= encodeURIComponent(categoriaAtual || '') %>&marca=<%= encodeURIComponent(marca || '') %>&ordem=<%= ordem || '' %>" class="text-dark text-decoration-none">
            Mostrar filtros <i class="bi bi-sliders ms-1"></i>
          </a>
        <% } else { %>
          <a href="<%= base %>?ocultar=1&categoria=<%= encodeURIComponent(categoriaAtual || '') %>&marca=<%= encodeURIComponent(marca || '') %>&ordem=<%= ordem || '' %>" class="text-dark text-decoration-none">
            Ocultar filtros <i class="bi bi-sliders ms-1"></i>
          </a>
        <% } %>

        <div class="dropdown">
          <a class="text-dark text-decoration-none dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
            Ordenar por: <strong><%= textoOrdem %></strong>
          </a>
          <ul class="dropdown-menu dropdown-menu-end">
            <li><a class="dropdown-item" href="<%= base %>?categoria=<%= encodeURIComponent(categoriaAtual || '') %>&marca=<%= encodeURIComponent(marca || '') %>&ocultar=<%= ocultar || '' %>">Relevância</a></li>
            <li><a class="dropdown-item" href="<%= base %>?ordem=menor&categoria=<%= encodeURIComponent(categoriaAtual || '') %>&marca=<%= encodeURIComponent(marca || '') %>&ocultar=<%= ocultar || '' %>">Menor preço</a></li>
            <li><a class="dropdown-item" href="<%= base %>?ordem=maior&categoria=<%= encodeURIComponent(categoriaAtual || '') %>&marca=<%= encodeURIComponent(marca || '') %>&ocultar=<%= ocultar || '' %>">Maior preço</a></li>
          </ul>
        </div>
      </div>
    </div>

    <div class="row">

      <!-- MENU LATERAL (MARCA / CATEGORIAS) -->
      <% if (ocultar != '1') { %>
        <div class="col-lg-2 mb-4">
          <form method="get" action="<%= base %>">
            <input type="hidden" name="ordem" value="<%= ordem || '' %>">
            <input type="hidden" name="ocultar" value="<%= ocultar || '' %>">

            <div class="mb-3">
              <a class="filtro-titulo d-flex justify-content-between mb-2" data-bs-toggle="collapse" href="#filtroCategoria" role="button">
                Categorias <i class="bi bi-chevron-up"></i>
              </a>
              <div class="collapse show" id="filtroCategoria">
                <div class="form-check">
                  <input class="form-check-input" type="radio" name="categoria" value="" id="catTodas"
                         onchange="this.form.submit()" <%= !categoriaAtual ? 'checked' : '' %>>
                  <label class="form-check-label" for="catTodas">Todas</label>
                </div>
                <% categorias.forEach((cat, i) => { %>
                  <div class="form-check">
                    <input class="form-check-input" type="radio" name="categoria" value="<%= cat.nome %>" id="cat<%= i %>"
                           onchange="this.form.submit()" <%= categoriaAtual === cat.nome ? 'checked' : '' %>>
                    <label class="form-check-label" for="cat<%= i %>"><%= cat.nome %></label>
                  </div>
                <% }) %>
              </div>
            </div>

            <% if (typeof marcas !== 'undefined' && marcas && marcas.length > 0) { %>
              <div class="mb-3">
                <a class="filtro-titulo d-flex justify-content-between mb-2" data-bs-toggle="collapse" href="#filtroMarca" role="button">
                  Marca <i class="bi bi-chevron-up"></i>
                </a>
                <div class="collapse show" id="filtroMarca">
                  <div class="form-check">
                    <input class="form-check-input" type="radio" name="marca" value="" id="marcaTodas"
                           onchange="this.form.submit()" <%= !marca ? 'checked' : '' %>>
                    <label class="form-check-label" for="marcaTodas">Todas</label>
                  </div>

                  <% marcas.forEach((item, i) => { %>
                    <div class="form-check">
                      <input class="form-check-input" type="radio" name="marca" value="<%= item.marca %>" id="marca<%= i %>"
                             onchange="this.form.submit()" <%= marca == item.marca ? 'checked' : '' %>>
                      <label class="form-check-label" for="marca<%= i %>"><%= item.marca %></label>
                    </div>
                  <% }) %>
                </div>
              </div>
            <% } %>
          </form>
        </div>
      <% } %>

      <!-- PRODUTOS -->
      <div class="<%= ocultar == '1' ? 'col-12' : 'col-lg-10' %>">
        <div class="row row-cols-1 g-4 <%= ocultar == '1' ? 'row-cols-md-4' : 'row-cols-md-3' %>">
          <% if (produtos.length === 0) { %>
            <div class="col-12">
              <p class="text-muted">Nenhum produto em destaque no momento.</p>
            </div>
          <% } else { %>
            <% produtos.forEach(produto => { %>
              <div class="col">
                <a href="/dados-produto/<%= produto.id %>" class="text-decoration-none text-dark">
                  <div class="product-img-wrapper mb-2">
                    <% if (produto.imagem) { %>
                      <img src="/uploads/<%= produto.imagem %>" alt="<%= produto.nome %>">
                    <% } else { %>
                      <i class="bi bi-image fs-1 text-muted"></i>
                    <% } %>
                  </div>
                  <h6 class="fw-bold mb-1"><%= produto.nome %></h6>
                  <small class="text-muted d-block mb-1"><%= produto.categoria %></small>
                  <span class="fw-bold">R$ <%= Number(produto.valor).toFixed(2).replace('.', ',') %></span>
                </a>
              </div>
            <% }) %>
          <% } %>
        </div>

        <p class="text-center text-muted small mt-5">
          Exibindo <%= produtos.length %> de <%= produtos.length %> produtos
        </p>
      </div>
    </div>
  </div>

  <%- include('partials/rodape') %>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>