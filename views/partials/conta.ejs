<% if (cliente) { %>
  <div class="dropdown">
    <a href="#" class="text-dark text-decoration-none dropdown-toggle small fw-bold" data-bs-toggle="dropdown">
      <i class="bi bi-person-check fs-5 me-1"></i> <%= cliente.nome.split(' ')[0] %>
    </a>
    <ul class="dropdown-menu dropdown-menu-end">
      <li><span class="dropdown-item-text small text-muted"><%= cliente.email %></span></li>
      <li><hr class="dropdown-divider"></li>
      <li><a class="dropdown-item" href="/logout"><i class="bi bi-box-arrow-right me-1"></i> Sair</a></li>
    </ul>
  </div>
<% } else { %>
  <a href="/login" class="text-dark fs-5"><i class="bi bi-person"></i></a>
<% } %>