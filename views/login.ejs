<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>KickOFF - Login</title>
  <link rel="icon" href="/icone/favicon.ico" type="image/x-icon">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
  
  <!-- CSS Externo -->
  <link rel="stylesheet" href="/css/login.css">
</head>
<body class="d-flex flex-column min-vh-100">

  <header class="border-bottom py-3">
    <div class="container-fluid px-4 d-flex justify-content-between align-items-center">
       <a class="navbar-brand py-0 d-flex align-items-center gap-2 text-decoration-none text-dark" href="/">
  <img src="/icone/Logo2.webp" alt="KICKOFF" style="height: 35px; width: auto; object-fit: contain;">
</a>
      
      <nav class="d-none d-md-flex gap-4 fw-semibold small align-items-center">
        <a href="/" class="text-dark text-decoration-none">Destaque</a>
        <% categorias.forEach(categoria => { %>
          <a href="/categoria/<%= categoria.nome %>" class="text-dark text-decoration-none"><%= categoria.nome %></a>
        <% }) %>
      </nav>
      
      <a href="/" class="text-dark text-decoration-none small fw-semibold">
        <i class="bi bi-arrow-left me-1"></i> Voltar à loja
      </a>
    </div>
  </header>

  <!-- Conteúdo Principal -->
  <main class="container my-auto py-4">
    <div class="row g-5 align-items-center">
      
      <div class="col-lg-6">
        <div class="bg-light-custom p-4 p-md-5 d-flex flex-column justify-content-between h-100 promo-box">
          <div>
            <span class="text-uppercase fw-bold text-white" style="font-size: 0.75rem; letter-spacing: 0.5px;">
              Dentro e fora de campo.
            </span>
            <h1 class="fw-bold my-3 display-5 lh-sm text-white">
              Seu próximo jogo começa aqui.
            </h1>
            <p class="mb-5 text-secondary">
              Acesse sua conta para acompanhar pedidos e encontrar sua próxima chuteira.
            </p>

            <div class="d-flex flex-column gap-4 my-4">
              <div class="d-flex align-items-start gap-3">
                <div class="flex-shrink-0">
                  <i class="bi bi-box-seam text-white fs-6"></i>
                </div>
                <div>
                  <h6 class="fw-bold mb-0 text-white">Seus pedidos, de perto</h6>
                  <small class="text-secondary">Acompanhe cada etapa da sua compra.</small>
                </div>
              </div>

              <div class="d-flex align-items-start gap-3">
                <div class="flex-shrink-0">
                  <i class="bi bi-shield-check text-white fs-6"></i>
                </div>
                <div>
                  <h6 class="fw-bold mb-0 text-white">Seu jogo, seu estilo</h6>
                  <small class="text-secondary">Futsal, futebol e society em um só lugar.</small>
                </div>
              </div>
            </div>
          </div>
          
          <div class="d-flex justify-content-between text-secondary fw-semibold small mt-5 pt-3 border-top border-secondary" style="font-size: 0.75rem;">
            <span>FUTSAL</span>
            <span>FUTEBOL</span>
            <span>SOCIETY</span>
          </div>
        </div>
      </div>
      
      <div class="col-lg-6 px-lg-5">
        <div class="mx-auto" style="max-width: 420px;">
          <span class="text-uppercase fw-bold text-muted" style="font-size: 0.75rem; letter-spacing: 0.5px;">
            Minha Conta
          </span>
          <h2 class="fw-bold my-2 text-dark">Bom ter você de volta.</h2>
          <p class="text-muted small mb-4">Entre na sua conta KickOFF e continue de onde parou.</p>

          <% if (sucesso) { %>
            <div class="alert alert-success py-2 small"><%= sucesso %></div>
          <% } %>

          <% if (aviso) { %>
            <div class="alert alert-warning py-2 small"><%= aviso %></div>
          <% } %>

          <% if (erro) { %>
            <div class="alert alert-danger py-2 small"><%= erro %></div>
          <% } %>

          <form action="/login" method="POST">
            <div class="mb-3">
              <label for="email" class="form-label small fw-bold mb-1">E-mail</label>
              <input type="email" class="form-control" id="email" name="email" placeholder="seuemail@exemplo.com" value="<%= email %>" required>
            </div>

            <div class="mb-3">
              <label for="senha" class="form-label small fw-bold mb-1">Senha</label>
              <div class="input-group">
                <input type="password" class="form-control border-end-0" id="senha" name="senha" placeholder="Digite sua senha" required>
                <button type="button" class="btn botao-olho" onclick="mostrarOcultar()">
                  <i id="iconeOlho" class="bi bi-eye-slash"></i>
                </button>
              </div>
            </div>

            <div class="d-flex justify-content-between align-items-center mb-4 small">
              <div class="form-check"></div>
              <a href="/recuperar" class="text-dark fw-bold text-decoration-underline">Esqueci minha senha</a>
            </div>

            <button type="submit" class="btn btn-dark-custom w-100 mb-4">Entrar</button>

            <div class="text-center">
              <p class="text-muted small mb-3">Ainda não faz parte do time?</p>
              <a href="/cadastro" class="btn btn-outline-custom w-100 text-decoration-none">Criar minha conta</a>
            </div>

            <div class="text-center mt-4 text-muted small d-flex align-items-center justify-content-center gap-1" style="font-size: 0.8rem;">
              <i class="bi bi-lock"></i>
              <span>Seus dados protegidos, seu jogo em foco.</span>
            </div>
          </form>
        </div>
      </div>

    </div>
  </main>

  <footer class="border-top py-3 mt-auto">
    <div class="container-fluid px-4 d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2 small text-muted">
      <span>&copy; 2026 KickOFF. Todos os direitos reservados.</span>
      <div class="d-flex gap-3">
        <a href="#" class="text-muted text-decoration-none">Privacidade</a>
        <a href="#" class="text-muted text-decoration-none">Termos de uso</a>
      </div>
    </div>
  </footer>

  <script>
    function mostrarOcultar() {
      const campo = document.getElementById('senha');
      const icone = document.getElementById('iconeOlho');

      if (campo.type === 'password') {
        campo.type = 'text';
        icone.className = 'bi bi-eye';
      } else {
        campo.type = 'password';
        icone.className = 'bi bi-eye-slash';
      }
    }
  </script>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>