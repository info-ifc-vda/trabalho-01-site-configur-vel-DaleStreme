<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Finalizar compra - KickOFF</title>
  <link rel="icon" href="/icone/favicon.ico" type="image/x-icon">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/pedido.css">
</head>
<body>

  <%- include('../partials/topbar') %>

  <!-- NAVBAR -->
  <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom py-2 px-4">
    <div class="container-fluid">
      <a class="navbar-brand text-decoration-none" href="/">KICKOFF</a>

      <div class="collapse navbar-collapse justify-content-center show">
        <ul class="navbar-nav gap-3 fw-bold">
          <li class="nav-item"><a class="nav-link" href="/">Destaques</a></li>
          <% categorias.forEach(categoria => { %>
            <li class="nav-item">
              <a class="nav-link" href="/categoria/<%= encodeURIComponent(categoria.nome) %>"><%= categoria.nome %></a>
            </li>
          <% }) %>
        </ul>
      </div>

      <div class="d-flex align-items-center gap-3">
        <a href="/login" class="text-dark fs-5"><i class="bi bi-person"></i></a>
        <a href="/carrinho" class="text-dark fs-5"><i class="bi bi-cart3"></i></a>
      </div>
    </div>
  </nav>

  <div class="container my-4 px-4">

    <!-- CAMINHO + PASSOS -->
    <div class="d-flex justify-content-between align-items-center mb-3">
      <div class="caminho">
        <a href="/">Início</a> / <a href="/carrinho">Carrinho</a> / Finalizar compra
      </div>

      <div class="stepper d-flex align-items-center gap-2">
        <div class="step-done d-flex align-items-center gap-1">
          <span class="step-number"><i class="bi bi-check-lg"></i></span>
          <span>Carrinho</span>
        </div>
        <span class="step-line"></span>
        <div class="step-active d-flex align-items-center gap-1">
          <span class="step-number">2</span>
          <span>Finalizar compra</span>
        </div>
        <span class="step-line"></span>
        <div class="step-inactive d-flex align-items-center gap-1">
          <span class="step-number">3</span>
          <span>Confirmação</span>
        </div>
      </div>
    </div>

    <h2 class="fw-bold mb-1" style="letter-spacing: -1px;">Finalizar compra</h2>
    <p class="text-muted small mb-4">Confira os dados do seu pedido antes de confirmar.</p>

    <% if (erro) { %>
      <div class="alert alert-danger py-2 small"><%= erro %></div>
    <% } %>

    <form action="/pedido/confirmar" method="POST">
      <div class="row g-4">

        <!-- COLUNA ESQUERDA -->
        <div class="col-lg-7">

          <!-- SEUS DADOS -->
          <div class="cartao mb-4">
            <h5 class="fw-bold mb-3">Seus dados</h5>
            <div class="row g-3">
              <div class="col-md-6">
                <span class="rotulo">Nome</span>
                <span class="valor"><%= cliente.nome %></span>
              </div>
              <div class="col-md-6">
                <span class="rotulo">E-mail</span>
                <span class="valor"><%= cliente.email %></span>
              </div>
            </div>
          </div>

          <!-- ENDEREÇO DE ENTREGA -->
          <div class="cartao mb-4">
            <h5 class="fw-bold mb-3">Endereço de entrega</h5>
            <div class="row g-3">
              <div class="col-md-4">
                <label for="cep" class="form-label small fw-bold">CEP</label>
                <input type="text" class="form-control" id="cep" name="cep" maxlength="9" placeholder="00000-000" value="<%= dados.cep || '' %>" required>
              </div>
              <div class="col-md-8">
                <label for="rua" class="form-label small fw-bold">Rua</label>
                <input type="text" class="form-control" id="rua" name="rua" value="<%= dados.rua || '' %>" required>
              </div>
              <div class="col-md-3">
                <label for="numero" class="form-label small fw-bold">Número</label>
                <input type="text" class="form-control" id="numero" name="numero" value="<%= dados.numero || '' %>" required>
              </div>
              <div class="col-md-9">
                <label for="complemento" class="form-label small fw-bold">Complemento <span class="text-muted fw-normal">(opcional)</span></label>
                <input type="text" class="form-control" id="complemento" name="complemento" value="<%= dados.complemento || '' %>">
              </div>
              <div class="col-md-5">
                <label for="bairro" class="form-label small fw-bold">Bairro</label>
                <input type="text" class="form-control" id="bairro" name="bairro" value="<%= dados.bairro || '' %>" required>
              </div>
              <div class="col-md-5">
                <label for="cidade" class="form-label small fw-bold">Cidade</label>
                <input type="text" class="form-control" id="cidade" name="cidade" value="<%= dados.cidade || '' %>" required>
              </div>
              <div class="col-md-2">
                <label for="estado" class="form-label small fw-bold">UF</label>
                <input type="text" class="form-control" id="estado" name="estado" maxlength="2" placeholder="SC" style="text-transform: uppercase;" value="<%= dados.estado || '' %>" required>
              </div>
            </div>
          </div>

          <!-- SEU PEDIDO -->
          <div class="cartao mb-4">
            <h5 class="fw-bold mb-1">Seu pedido</h5>
            <span class="text-muted small d-block mb-2"><%= resumo.totalQtd %> produto(s)</span>

            <% resumo.itens.forEach(item => { %>
              <div class="d-flex align-items-center gap-3 py-3 border-bottom">
                <div class="item-img">
                  <% if (item.imagem) { %>
                    <img src="/uploads/<%= item.imagem %>" alt="<%= item.nome %>">
                  <% } else { %>
                    <i class="bi bi-image text-muted fs-4"></i>
                  <% } %>
                </div>
                <div class="flex-grow-1">
                  <div class="fw-bold"><%= item.nome %></div>
                  <small class="text-muted"><%= item.categoria %> | Tamanho: <%= item.tamanho %> | Qtd: <%= item.qtd %></small>
                </div>
                <div class="fw-bold">R$ <%= (item.valor * item.qtd).toFixed(2).replace('.', ',') %></div>
              </div>
            <% }) %>
          </div>

          <!-- FORMA DE PAGAMENTO -->
          <div class="cartao">
            <h5 class="fw-bold mb-3">Forma de pagamento</h5>

            <label class="opcao-pagamento">
              <input type="radio" class="form-check-input" name="pagamento" value="pix" required <%= dados.pagamento == 'pix' ? 'checked' : '' %>>
              <i class="bi bi-qr-code fs-5"></i>
              <div>
                <div class="fw-bold">Pix</div>
                <small class="text-muted">Aprovação imediata</small>
              </div>
            </label>

            <label class="opcao-pagamento">
              <input type="radio" class="form-check-input" name="pagamento" value="boleto" <%= dados.pagamento == 'boleto' ? 'checked' : '' %>>
              <i class="bi bi-upc fs-5"></i>
              <div>
                <div class="fw-bold">Boleto</div>
                <small class="text-muted">Vencimento em 3 dias úteis</small>
              </div>
            </label>

            <label class="opcao-pagamento mb-0">
              <input type="radio" class="form-check-input" name="pagamento" value="cartao" <%= dados.pagamento == 'cartao' ? 'checked' : '' %>>
              <i class="bi bi-credit-card fs-5"></i>
              <div>
                <div class="fw-bold">Cartão</div>
                <small class="text-muted">Crédito ou débito</small>
              </div>
            </label>
          </div>

        </div>

        <!-- COLUNA DIREITA: RESUMO -->
        <div class="col-lg-5">
          <div class="resumo-card">
            <h5 class="fw-bold mb-1">Resumo do pedido</h5>
            <span class="text-muted small d-block mb-4"><%= resumo.totalQtd %> produto(s) na sua sacola</span>

            <div class="d-flex justify-content-between mb-2 small">
              <span class="text-muted">Subtotal</span>
              <span class="fw-semibold">R$ <%= resumo.subtotal.toFixed(2).replace('.', ',') %></span>
            </div>

            <% if (resumo.desconto > 0) { %>
              <div class="d-flex justify-content-between mb-2 small">
                <span class="text-muted">Cupom <%= resumo.cupom.codigo %></span>
                <span class="text-success fw-semibold">- R$ <%= resumo.desconto.toFixed(2).replace('.', ',') %></span>
              </div>
            <% } %>

            <div class="d-flex justify-content-between mb-4 small">
              <span class="text-muted">Entrega padrão</span>
              <span class="fw-semibold">R$ <%= resumo.frete.toFixed(2).replace('.', ',') %></span>
            </div>

            <div class="d-flex justify-content-between align-items-baseline pt-3 border-top mb-4">
              <span class="fw-bold fs-5">Total</span>
              <span class="fw-bold fs-4" style="letter-spacing: -0.5px;">R$ <%= resumo.total.toFixed(2).replace('.', ',') %></span>
            </div>

            <div class="d-grid gap-2">
              <button type="submit" class="btn btn-preto w-100">Confirmar pedido</button>
              <a href="/carrinho" class="btn btn-contorno w-100 text-decoration-none">Voltar ao carrinho</a>
            </div>

            <div class="text-center mt-3 text-muted small d-flex align-items-center justify-content-center gap-1" style="font-size: 11px;">
              <i class="bi bi-lock"></i>
              <span>Compra segura. Seus dados protegidos.</span>
            </div>
          </div>
        </div>

      </div>
    </form>
  </div>

  <%- include('../partials/rodape') %>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>